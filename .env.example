## Local development configuration for the shared-board GitHub sync.
## Copy this file to .env.local (git-ignored) and fill in your own values,
## or export the same variables before running `npm run dev` / `npm run build`.
## In production these are supplied by the GitHub Actions workflow
## (.github/workflows/deploy.yml) from repository secrets/variables, not this file.

VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=your-repo-name
VITE_GITHUB_BRANCH=main

## A fine-grained personal access token, scoped ONLY to this one repository,
## with Contents: Read and write permission and nothing else.
## WARNING: this token ends up embedded in the built JavaScript bundle and is
## publicly retrievable by anyone who opens the deployed site. Only use a token
## with the smallest possible scope, on a repository that holds nothing sensitive.
VITE_GITHUB_TOKEN=github_pat_xxx

## Secret that turns "#/admin?key=<this>" into an admin invite link. Anyone who opens
## the link becomes an admin in that browser (no account needed). Pick a long random
## string, e.g. `openssl rand -hex 16`. Like the token, it is visible in the bundle.
VITE_ADMIN_KEY=change-me
